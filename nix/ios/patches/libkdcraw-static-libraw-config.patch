diff --git a/cmake/modules/FindLibRaw.cmake b/cmake/modules/FindLibRaw.cmake
index 5a1e2d0..51f6606 100644
--- a/cmake/modules/FindLibRaw.cmake
+++ b/cmake/modules/FindLibRaw.cmake
@@ -84,4 +84,15 @@ if(LibRaw_FOUND AND NOT TARGET LibRaw::LibRaw)
         INTERFACE_COMPILE_OPTIONS "${LibRaw_DEFINITIONS}"
         INTERFACE_INCLUDE_DIRECTORIES "${LibRaw_INCLUDE_DIR}"
     )
+    if("${LibRaw_LIBRARIES}" MATCHES "\\${CMAKE_STATIC_LIBRARY_SUFFIX}$")
+        set(_LibRaw_STATIC_LINK_LIBRARIES ${PC_LIBRAW_STATIC_LINK_LIBRARIES})
+        list(REMOVE_ITEM _LibRaw_STATIC_LINK_LIBRARIES "${LibRaw_LIBRARIES}")
+        set_property(TARGET LibRaw::LibRaw PROPERTY
+            INTERFACE_LINK_LIBRARIES "${_LibRaw_STATIC_LINK_LIBRARIES}")
+        set_property(TARGET LibRaw::LibRaw PROPERTY
+            INTERFACE_LINK_OPTIONS "${PC_LIBRAW_STATIC_LDFLAGS_OTHER}")
+        set_property(TARGET LibRaw::LibRaw PROPERTY
+            INTERFACE_COMPILE_OPTIONS "${PC_LIBRAW_STATIC_CFLAGS_OTHER}")
+        unset(_LibRaw_STATIC_LINK_LIBRARIES)
+    endif()
 endif()
